{
  "name": "@kentos/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kentos paylaşılan çekirdek: backend modüllerinden OpenAPI ile üretilen tipli API client'ları + TanStack Query hook'ları (web + mobile ortak).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./modules/*": "./src/modules/*/index.ts"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@types/react": "^19.0.8",
    "openapi-typescript": "^7.6.1",
    "react": "^19.0.0",
    "typescript": "^5.7.3"
  }
}
