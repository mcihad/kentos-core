# ============================================================================
# Kentos Core - environment template. Copy to `.env` and adjust per machine.
# Double underscore (__) maps to nested configuration keys in .NET.
# ============================================================================

# ---- Database ----
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=kentos;Username=kentos;Password=kentos;Include Error Detail=true
ConnectionStrings__Mongo=mongodb://localhost:27017
Mongo__Database=kentos_audit

# ---- Database (apply EF migrations on startup; set false to migrate out-of-band) ----
Database__MigrateOnStartup=true

# ---- JWT (self-issued access/refresh tokens) ----
Jwt__Issuer=kentos
Jwt__Audience=kentos
Jwt__SigningKey=dev-only-change-me-please-use-a-32+byte-secret-key
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# ---- Hesap module bootstrap admin (created idempotently at startup) ----
Hesap__Bootstrap__UserName=admin
Hesap__Bootstrap__Password=Admin!234
Hesap__Bootstrap__Email=admin@kentos.local

# ---- Audit (Postgres for dev, Mongo for prod) ----
Audit__Provider=Postgres

# ---- Geo / PostGIS ----
Geo__Srid=4326

# ---- CORS ----
Cors__AllowedOrigins=http://localhost:5080,http://localhost:3000

# ---- License (which modules are enabled) ----
License__EnabledModules=settlement

# ---- OpenTelemetry ----
OpenTelemetry__OtlpEndpoint=http://localhost:4317
OpenTelemetry__ServiceName=kentos
