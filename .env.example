# ============================================================================
# Kentos Core - environment template. Copy to `.env` and adjust per machine.
# Double underscore (__) maps to nested configuration keys in .NET.
# ============================================================================

# ---- Database ----
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=kentos;Username=kentos;Password=kentos;Include Error Detail=true
ConnectionStrings__Mongo=mongodb://localhost:27017
Mongo__Database=kentos_audit

# ---- Keycloak (API resource server / token validation) ----
Keycloak__Authority=http://localhost:8080/realms/kentos
Keycloak__MetadataAddress=http://localhost:8080/realms/kentos/.well-known/openid-configuration
Keycloak__Audience=kentos-client
Keycloak__RequireHttpsMetadata=false

# ---- Keycloak Admin (used by Kentos.AdminCli for provisioning) ----
Keycloak__ServerUrl=http://localhost:8080
Keycloak__AdminRealm=master
Keycloak__AdminUser=admin
Keycloak__AdminPassword=admin
Keycloak__Realm=kentos
Keycloak__ClientId=kentos-client
Keycloak__LoginTheme=
Keycloak__RedirectUris=http://localhost:5080/scalar/*,http://localhost:5080/*
Keycloak__WebOrigins=http://localhost:5080
Keycloak__DevTestUser=admin@kentos
Keycloak__DevTestPassword=Admin!234

# ---- Audit (Postgres for dev, Mongo for prod) ----
Audit__Provider=Postgres

# ---- Geo / PostGIS ----
Geo__Srid=4326

# ---- CORS ----
Cors__AllowedOrigins=http://localhost:5080,http://localhost:3000

# ---- License (which modules are enabled) ----
License__EnabledModules=settlement

# ---- OpenTelemetry ----
OpenTelemetry__OtlpEndpoint=http://localhost:4317
OpenTelemetry__ServiceName=kentos
