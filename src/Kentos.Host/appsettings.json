{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=kentos;Username=kentos;Password=kentos;Include Error Detail=true",
    "Mongo": "mongodb://localhost:27017"
  },
  "Mongo": {
    "Database": "kentos_audit"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/kentos",
    "MetadataAddress": "http://localhost:8080/realms/kentos/.well-known/openid-configuration",
    "Audience": "kentos-client",
    "RequireHttpsMetadata": false,
    "ServerUrl": "http://localhost:8080",
    "Realm": "kentos",
    "ClientId": "kentos-client"
  },
  "Audit": {
    "Provider": "Postgres"
  },
  "Geo": {
    "Srid": 4326
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5080,http://localhost:3000"
  },
  "License": {
    "EnabledModules": "settlement"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "kentos"
  }
}
