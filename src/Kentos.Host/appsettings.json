{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kentos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "shared": true,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=kentos;Username=kentos;Password=kentos;Include Error Detail=true",
    "Mongo": "mongodb://localhost:27017"
  },
  "Mongo": {
    "Database": "kentos_audit"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "kentos",
    "Audience": "kentos",
    "SigningKey": "dev-only-change-me-please-use-a-32+byte-secret-key",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Hesap": {
    "Bootstrap": {
      "UserName": "admin",
      "Password": "Admin!234",
      "Email": "admin@kentos.local"
    }
  },
  "Audit": {
    "Provider": "Postgres"
  },
  "Geo": {
    "Srid": 4326
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5080,http://localhost:3000"
  },
  "License": {
    "EnabledModules": "settlement"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "kentos"
  }
}
